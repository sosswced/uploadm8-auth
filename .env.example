# Copy to .env and fill in secrets. Never commit .env.
# See render.yaml for production-oriented defaults.

# Core
DATABASE_URL=postgresql://user:password@localhost:5432/uploadm8
JWT_SECRET=change-me-min-32-chars-random
BASE_URL=http://127.0.0.1:8000
# If OAuth providers redirect to a public URL (ngrok, cloudflared) but the app binds locally, set this to that
# public origin so /api/oauth/{platform}/callback matches the TikTok/Meta/Google portal registration.
# OAUTH_PUBLIC_BASE_URL=https://abc123.ngrok-free.app
FRONTEND_URL=http://127.0.0.1:8080
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Tokens
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
JWT_ISSUER=https://auth.uploadm8.com
JWT_AUDIENCE=uploadm8-app
TOKEN_ENC_KEYS=

# Redis / queues
REDIS_URL=
PROCESS_PRIORITY_QUEUE=uploadm8:process:priority
PROCESS_NORMAL_QUEUE=uploadm8:process:normal

# R2 / S3-compatible storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=uploadm8-media
R2_ENDPOINT_URL=
R2_PRESIGN_UPLOAD_TTL=7200

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://127.0.0.1:8080/billing/success.html?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://127.0.0.1:8080/index.html#pricing

# OpenAI / optional data files
OPENAI_API_KEY=
GAZETTEER_PLACES_PATH=
PADUS_PATH=
PADUS_LAYER=

# Observability
LOG_LEVEL=INFO
JSON_LOGS=1
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_TRACES_RATE=0.1
METRICS_API_KEY=

# Caption evidence: FactLedger soft-weave + hashtag pad (default on).
# UPLOADM8_FACT_LEDGER=false
# UPLOADM8_FACT_LEDGER_STRICT=true
# UPLOADM8_HYDRATION_PAYLOAD=false

# Rate limits / pool
# Production (Render/Cloudflare): TRUST_PROXY_HEADERS=1 and RATE_LIMIT_LOOPBACK_BYPASS=0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_ADMIN_PER_MIN=60
RATE_LIMIT_WINDOW_SEC=60
DB_POOL_MIN=2
DB_POOL_MAX=10
TRUST_PROXY_HEADERS=0
# RATE_LIMIT_LOOPBACK_BYPASS=false

# OAuth (set what you use)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Meta OAuth: full = production (instagram_*, pages_manage_posts, read_insights). Do not request publish_video (live streaming only).
# minimal = pages_show_list, pages_read_engagement, business_management. custom = META_*_OAUTH_SCOPE overrides.
META_OAUTH_MODE=full
# META_INSTAGRAM_OAUTH_SCOPE=
# META_FACEBOOK_OAUTH_SCOPE=
# TikTok Login Kit: redirect URI must match the app config exactly ΓÇö same scheme, host, port, path as
# BASE_URL + /api/oauth/tiktok/callback (no query string, no #fragment). Web docs often show https-only;
# for local dev use the exact URL you register (e.g. https ngrok tunnel) or a portal-approved test URL.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_WEBHOOK_SECRET=
# Content Posting Direct Post is audit-approved in code (public privacy honored).
# Do not set legacy TIKTOK_APP_AUDITED / TIKTOK_FORCE_PRIVATE_UNAUDITED — ignored.

# Mailgun + deliverability (DNS SPF/DKIM/DMARC on uploadm8.com via Cloudflare - see Mailgun domain settings)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mail.uploadm8.com
MAILGUN_DISABLE_TRACKING=true
# Default sender for ops/notify paths; auth/welcome use MAIL_FROM_HELLO via stages/emails/base.py
MAIL_FROM=UploadM8 <hello@uploadm8.com>
MAIL_FROM_HELLO=UploadM8 <hello@uploadm8.com>
MAIL_FROM_SUPPORT=UploadM8 Support <support@uploadm8.com>
SUPPORT_EMAIL=support@uploadm8.com
MAIL_PHYSICAL_ADDRESS=UploadM8 · 548 Market St PMB · San Francisco, CA 94104
MAIL_LOGO_URL=https://app.uploadm8.com/images/logo.png
# Production: FRONTEND_URL=https://app.uploadm8.com (already set above for local)
# Optional: MAILGUN_MARKETING_TRACKING=true for campaign open pixels only (transactional stays off)

# Cloudflare (R2 + analytics API - separate from Mailgun DNS)
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Upload pipeline tuning (single-pass watermark burns in transcode - avoids free-tier double encode)
WATERMARK_SINGLE_PASS=true
STAGE_TIMEOUT_THUMBNAIL_SEC=600
STAGE_TIMEOUT_AUDIO_SEC=240
STAGE_TIMEOUT_VIDEO_INTELLIGENCE_SEC=1800
WORKER_HEAVY_PIPELINE_SLOTS=1
# Worker scaling: full | process (FFmpeg) | publish (API rate limits). Scale process/publish fleets independently.
# On Render Starter (512MB): WORKER_CONCURRENCY=1 and PUBLISH_CONCURRENCY=1 are mandatory.
WORKER_LANE=full
WORKER_CONCURRENCY=1
PUBLISH_CONCURRENCY=1
HEARTBEAT_INTERVAL_SECONDS=10
# Per-user cluster-wide process cap (wait in place - do not re-enqueue every 2s)
USER_PROCESS_MAX_PARALLEL=2
USER_PROCESS_MAX_PARALLEL_PRIORITY=4
USER_SLOT_MAX_WAIT_SEC=900
# Render worker RAM — set explicitly on Starter (512MB) so admit % matches reality
# RENDER_MEMORY_LIMIT_MB=512
# Soft admit / hard block defaults: 75/88 on ≥2GB; 55/70 on ≤768MB
# MEMORY_ADMIT_PCT=55
# MEMORY_HARD_PCT=70
# Log memory pressure when RSS exceeds this % of Render limit (60 on small, 85 on Standard)
MEMORY_WARN_PCT=85
# Parallel multimodal OOMs 512MB — leave unset (auto false on small) or force:
# MULTIMODAL_PARALLEL=false
# Cap inline Video Intelligence RAM (auto 20MiB on ≤768MB; env >20MiB is clamped
# on Starter unless VIDEO_INTELLIGENCE_MAX_BYTES_FORCE=1):
# VIDEO_INTELLIGENCE_MAX_BYTES=20971520
# VIDEO_INTELLIGENCE_STAGE_ENABLED=false
# Prefer removing a leftover 104857600 from Render Starter env.
TWELVE_LABS_PARALLEL=true
REDIS_JOB_USE_STREAMS=true
REDIS_JOB_LEGACY_DRAIN=true
STREAM_RECLAIM_INTERVAL_SEC=25
STREAM_RECLAIM_MIN_IDLE_MS=120000
STREAM_RECLAIM_COUNT=8
USER_PROCESS_MAX_PARALLEL=3

# AI trace (prod: enable per tier)
AI_TRACE_ENABLED=false
AI_TRACE_TIERS=pro,studio,agency

# ML engine
UM8_ML_ENGINE_ENABLED=1
UM8_ML_ENGINE_RUN_CONTENT_SUCCESS=1
UM8_HF_CONTENT_DATASET_REPO=your-org/uploadm8-content-success-v1
UM8_HF_CONTENT_MODEL_REPO=your-org/uploadm8-content-success-model-v1
MARKETING_ML_TARGETING_ENABLED=1
UM8_PROMO_MIN_SCORE=0.35

# E2E / overnight Playwright (upload.html file pair)
E2E_TEST_VIDEO=C:\Users\Earl\Videos\20250224_0073_CAM_EVNT.MP4
E2E_TEST_TELEMETRY_MAP=C:\Users\Earl\Videos\20250224_0073_CAM_EVNT.map
# Include heavy GET routes (pikzels, thumbnail-studio jobs) in API smoke sweeps
# E2E_INCLUDE_SLOW_API=1
