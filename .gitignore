# Secrets (never commit)
.env
.env.*
!.env.example
frontend/js/official-brand-secrets.local.js
**/official-brand-secrets.local.js

# Assisted brand social signup (OTP + screenshots + stop/go flags)
scripts/agent/.brand_otp
scripts/agent/.brand_continue
scripts/agent/.brand_stop
scripts/agent/.brand_signup_status.json
scripts/agent/.brand_secrets.local.json
scripts/agent/.brand_signup_shots/

# Local debug / investigation scripts (PII + prod DB footguns)
_tmp_*.py
_tmp_*.json
_tmp_*.txt

# Local ML training exports (may embed user_id / upload_id / balances)
# Runtime models sync from Hugging Face via services/ml_model_sync.py
data/ml/*.parquet
data/ml/*_report.json
data/ml/*.joblib
data/ml/engine_state.json
data/ml/test_*.*

# Python
.venv/
.venv-*/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.egg-info/
dist/
build/

# OS / editor noise (keep team .vscode if you commit it on purpose)
.DS_Store
Thumbs.db
*.swp
*.swo
